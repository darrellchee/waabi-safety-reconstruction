      "background": "rgb(232, 230, 227)"
    },
    {
      "tag": "SECTION",
      "text": "I get to work on tough, meaningful problems with world-class peers who share a scientific mindset, constantly advancing our simulator to validate safe self-driving at the highest fidelity.\n\nSahil Jain\nSoftware Developer II, Sensor Simulation\n1\n/ 9\nWaabi voices.",
      "cls": "careers-voices",
      "rect": {
        "x": 0,
        "y": 2620.75,
        "width": 390,
        "height": 728.4375,
        "top": 2620.75,
