    {
      "tag": "SECTION",
      "text": "Help us tackle the world's biggest challenges. Whether you're an engineer, an AI researcher, a transportation expert, a business specialist, or a student looking to grow your career, Waabi is where you'll solve real problems for real vehicles on real roads\u2014while shaping entire industries.\n\nJoin the team",
      "cls": "careers-intro",
      "rect": {
        "x": 0,
        "y": 904,
        "width": 390,
        "height": 514,
        "top": 904,
        "right": 390,
